	<TextNote TextNoteId="1259c60a-6106-4aca-bf69-7bc4ab84ab61" LogicalCircuitId="952bca8d-c415-4cd5-8448-b1d36507b549" X="17" Y="2" Height="6" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;este es un selector de registro en 3 bits, para seleccionar 8 regitros en el ram de 64 bits (8 celdas de 8 bits)&lt;/Paragraph&gt;&lt;Paragraph /&gt;&lt;/FlowDocument&gt;" />
