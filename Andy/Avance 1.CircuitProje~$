	<TextNote TextNoteId="33684e44-5de0-49c2-a795-49317127b4b8" LogicalCircuitId="49cfbc15-7448-4bb6-ae12-7a6326d002f1" X="3" Y="2" Width="54" Height="9" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;Esta es una celda de 2 bits usando Flip Flops JK&lt;/Paragraph&gt;&lt;Paragraph&gt;recibe dos pines de registro por arriba, uno de selección de la celda actual y uno para seleccionar las celdas de flip flop&lt;/Paragraph&gt;&lt;Paragraph&gt;más un pin superior adicionar como gatillo para disparar la lectura a las celdas&lt;/Paragraph&gt;&lt;Paragraph&gt;un pin de entrada a la izquierda para definir qué se va a escribir&lt;/Paragraph&gt;&lt;Paragraph&gt;pines de salida a la derecha para la información que sale&lt;/Paragraph&gt;&lt;Paragraph&gt;pines inferiores para pasar la señal de registro y gatillo a la siguiente celda, y un pin de entrada inferior para el botón de limpiar las celdas&lt;/Paragraph&gt;&lt;Paragraph xml:space=&quot;preserve&quot; /&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="323e93d7-1f97-4feb-a8a6-590e90f0f9b7" LogicalCircuitId="d6b48a8c-c4cf-466f-9001-6eeb96118b72" X="1" Y="1" Width="38" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;Esta es la celda de 4 bits, usa dos celdas de 2 bits&lt;/Paragraph&gt;&lt;Paragraph&gt;Recibe 3 pines de registro, el primero selecciona la celda y los otros dos se alimentan a las celdas hijas de 2 bits,&lt;/Paragraph&gt;&lt;Paragraph&gt;Recibe un pin de Gatillo que junto con el pin de registro de selección habilita el gatillo para las celdas hijas&lt;/Paragraph&gt;&lt;Paragraph&gt;Recibe un pin de escritura a la izquierda&lt;/Paragraph&gt;&lt;Paragraph&gt;Tiene 3 pines de salida inferior para pasar el registro y el gatillo a la celda hermana&lt;/Paragraph&gt;&lt;Paragraph&gt;Tiene un pin de entrada inferior para limpiar todas las celdas&lt;/Paragraph&gt;&lt;Paragraph&gt;Tiene 4 pines de salida a la derecha para la salida de información&lt;/Paragraph&gt;&lt;Paragraph xml:space=&quot;preserve&quot; /&gt;&lt;/FlowDocument&gt;" />
