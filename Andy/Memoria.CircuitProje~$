	<TextNote TextNoteId="1259c60a-6106-4aca-bf69-7bc4ab84ab61" LogicalCircuitId="952bca8d-c415-4cd5-8448-b1d36507b549" X="3" Y="2" Height="6" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;este es un selector de registro en 3 bits, para seleccionar 8 regitros en el ram de 64 bits (8 celdas de 8 bits)&lt;/Paragraph&gt;&lt;Paragraph /&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="5cc46962-71c4-4aca-8e56-c42bd6c92792" LogicalCircuitId="952bca8d-c415-4cd5-8448-b1d36507b549" X="15" Y="11" Height="6" Note="&lt;FlowDocument PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;es practicamente 3 compuertas Y para cada salida, convirtiendo las 3 entradas a 1 se&lt;Run xml:lang=&quot;es-cr&quot;&gt;ñal positiva entre las 8 salidas&lt;/Run&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="bc9c5062-d43c-44fc-8f40-715fef4ea57d" LogicalCircuitId="7b0ce35d-9622-4900-9af7-2c7f892e5968" X="13" Y="6" Width="15" Height="5" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-us&quot;&gt;usa 8 Latch-8 para guardar información en paralelo, tiene 9 entradas, 1 para indicar escritura y 8 para escribir la información directamente, y tiene 8 salidas&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph Margin=&quot;0,6,2,6&quot;&gt;&lt;Run xml:lang=&quot;es-us&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="14e7a44a-d978-4842-9c3e-717e628b5e16" LogicalCircuitId="8ba65532-e824-43da-90fa-5857b3a5c4cf" X="19" Width="11" Height="6" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot; xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;3 bits de registro de entrada para las 8 celdas de ram, se convierten en 8 salidas donde solo una posee un valor verdadero&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph Margin=&quot;0,6,2,6&quot;&gt;&lt;Run xml:lang=&quot;es-cr&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
	<TextNote TextNoteId="726fd167-980d-4ea5-9809-3ca85db145ea" LogicalCircuitId="8ba65532-e824-43da-90fa-5857b3a5c4cf" X="48" Y="5" Width="34" Note="&lt;FlowDocument TextAlignment=&quot;Left&quot; PagePadding=&quot;5,0,5,0&quot; AllowDrop=&quot;True&quot; NumberSubstitution.CultureSource=&quot;User&quot; xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot; xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-cr&quot; xml:space=&quot;preserve&quot;&gt;Nota: &lt;/Run&gt;&lt;LineBreak /&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;pines superiores en orden: digito registro 3, digito registro 2, digito registro 1, lectura (1) escritura(0) y gatillo (1 dispara, 0 impide operación del modulo)&lt;/Run&gt;&lt;LineBreak /&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;pines inferiores son la salida de los pines superiores&lt;/Run&gt;&lt;LineBreak /&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;pines de la izquierda son 8 para escritura&lt;/Run&gt;&lt;LineBreak /&gt;&lt;Run xml:lang=&quot;es-cr&quot;&gt;pines a la derecha son 8 para lectura&lt;/Run&gt;&lt;/Paragraph&gt;&lt;Paragraph&gt;&lt;Run xml:lang=&quot;es-cr&quot; xml:space=&quot;preserve&quot; /&gt;&lt;/Paragraph&gt;&lt;/FlowDocument&gt;" />
